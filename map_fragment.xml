    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAppInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/app_info_txt"
        android:src="@drawable/outline_show_info_marker"
        android:tint="@android:color/white"
        app:backgroundTint="@color/purple"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabStartWifiNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/start_navigation"
        android:src="@drawable/ic_start_wifi_navi"
        android:tint="@android:color/black"
        app:backgroundTint="@color/green"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fabAppInfo" />

    <!-- ===== RIGHT SIDE: Route Drawing Controls ===== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDrawRoute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/draw_route"
        android:src="@drawable/outline_route"
        app:backgroundTint="@color/blue"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@android:color/white" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/delete_route"
        android:src="@drawable/outline_delete_route"
        android:tint="@android:color/white"
        app:backgroundTint="@color/blue"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="@id/fabDrawRoute"
        app:layout_constraintEnd_toStartOf="@id/fabDrawRoute" />

